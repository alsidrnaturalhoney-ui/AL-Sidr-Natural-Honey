{
  "version": "1.0.0",
  "date": "2026-09-26",
  "secretRule": "Never store credential values in Git, Notion, Airtable, prompts, issues or chat. Use provider/OAuth secret stores only.",
  "credentials": [
    {
      "provider": "OpenAI Platform",
      "credential": "project API key",
      "env": [
        "OPENAI_API_KEY"
      ],
      "minimumScopes": [
        "project API access"
      ],
      "status": "secure-setup-available",
      "storage": "deployment secret store",
      "rotation": "provider revoke + replace"
    },
    {
      "provider": "Meta Graph API",
      "credential": "OAuth/system-user token",
      "env": [
        "META_ACCESS_TOKEN",
        "META_BUSINESS_ID"
      ],
      "minimumScopes": [
        "only approved Instagram/Facebook business read/write scopes"
      ],
      "status": "needs-provider-authorization",
      "storage": "deployment secret store",
      "rotation": "provider token lifecycle"
    },
    {
      "provider": "Threads",
      "credential": "OAuth access token",
      "env": [
        "THREADS_ACCESS_TOKEN",
        "THREADS_USER_ID"
      ],
      "minimumScopes": [
        "approved profile/publish scopes"
      ],
      "status": "needs-provider-authorization",
      "storage": "deployment secret store",
      "rotation": "provider token lifecycle"
    },
    {
      "provider": "Pinterest",
      "credential": "OAuth access token",
      "env": [
        "PINTEREST_ACCESS_TOKEN"
      ],
      "minimumScopes": [
        "boards/pins/catalog scopes only as required"
      ],
      "status": "needs-provider-authorization",
      "storage": "deployment secret store",
      "rotation": "provider token lifecycle"
    },
    {
      "provider": "X",
      "credential": "OAuth 2.0 user token",
      "env": [
        "X_CLIENT_ID",
        "X_CLIENT_SECRET",
        "X_ACCESS_TOKEN"
      ],
      "minimumScopes": [
        "tweet.read",
        "users.read",
        "offline.access",
        "tweet.write only if approved"
      ],
      "status": "needs-provider-authorization",
      "storage": "deployment secret store",
      "rotation": "provider revoke + replace"
    },
    {
      "provider": "WhatsApp Cloud API",
      "credential": "business OAuth/token",
      "env": [
        "WHATSAPP_ACCESS_TOKEN",
        "WHATSAPP_PHONE_NUMBER_ID"
      ],
      "minimumScopes": [
        "whatsapp_business_messaging",
        "whatsapp_business_management as required"
      ],
      "status": "needs-provider-authorization",
      "storage": "deployment secret store",
      "rotation": "provider token lifecycle"
    },
    {
      "provider": "Amazon Selling Partner API",
      "credential": "OAuth/LWA + role credentials",
      "env": [
        "AMAZON_SP_API_CLIENT_ID",
        "AMAZON_SP_API_CLIENT_SECRET",
        "AMAZON_SP_API_REFRESH_TOKEN"
      ],
      "minimumScopes": [
        "catalog/listings/orders only as approved"
      ],
      "status": "needs-provider-authorization",
      "storage": "deployment secret store",
      "rotation": "provider revoke + replace"
    },
    {
      "provider": "Noon",
      "credential": "partner/API credential if programmatically supported",
      "env": [
        "NOON_API_KEY"
      ],
      "minimumScopes": [
        "catalog/listing/returns only as provided by Noon"
      ],
      "status": "provider-access-not-yet-verified",
      "storage": "deployment secret store",
      "rotation": "provider-defined"
    },
    {
      "provider": "Tabby",
      "credential": "merchant API/OAuth credential if required",
      "env": [
        "TABBY_SECRET_KEY",
        "TABBY_MERCHANT_CODE"
      ],
      "minimumScopes": [
        "merchant integration only"
      ],
      "status": "provider-access-not-yet-verified",
      "storage": "deployment secret store",
      "rotation": "provider-defined"
    },
    {
      "provider": "Klaviyo",
      "credential": "managed OAuth/app connection",
      "env": [],
      "minimumScopes": [
        "brand/read-write only when reauthorized",
        "campaign/flow scopes as needed"
      ],
      "status": "reconnect-required-for-brand-api",
      "storage": "managed connector",
      "rotation": "reconnect/revoke app"
    }
  ]
}
